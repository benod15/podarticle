# PodArticle production env (set in Vercel dashboard — never commit real values)

# Gemini — https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Supadata — https://dash.supadata.ai → API keys
SUPADATA_API_KEY=

# Supabase — project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Paywall — unset or false keeps PodArticle free for everyone (current state).
# Set to true to re-arm the free-5 gate and the Stripe checkout that sits behind it.
PAYWALL_ENABLED=false

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=     # $5/mo billed $60/yr price id
STRIPE_PRICE_MONTHLY=    # $10/mo price id
