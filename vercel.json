{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/analyze.js": { "maxDuration": 300 },
    "api/episodes.js": { "maxDuration": 30 },
    "api/checkout.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/episodes/:slug", "destination": "/episodes/:slug.html" },
    { "source": "/e/:vid", "destination": "/api/episode-page?vid=:vid" }
  ]
}
